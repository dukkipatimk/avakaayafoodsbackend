# Server
PORT=8001
NODE_ENV=development
FRONTEND_URL=http://localhost:3000
# Public base URL of this backend — used to build uploaded image URLs.
# Production: https://api.avakaayafoods.com
BACKEND_URL=http://localhost:8001

# MongoDB
# MONGO_URI=mongodb://localhost:27017/avakaayfoods

# JWT
JWT_SECRET=your_super_secret_jwt_key_change_this_in_production
JWT_EXPIRE=7d

# Razorpay (handles UPI, cards, netbanking, wallets)
# Get keys from https://dashboard.razorpay.com → Account & Settings → API Keys
RAZORPAY_KEY_ID=rzp_test_SoZWPINHCcHTFc
RAZORPAY_KEY_SECRET=JWcmcvzbO0hGHvlRZWFIMJK0
# Razorpay webhook secret — Dashboard → Webhooks → Add Endpoint
# Subscribe to: payment.captured, payment.authorized, payment.failed
# URL: https://api.avakaayafoods.com/api/payment/webhook
RAZORPAY_WEBHOOK_SECRET=your_webhook_secret

# For ICICI Bank direct integration
ICICI_MERCHANT_ID=your_icici_merchant_id
ICICI_WORKING_KEY=your_icici_working_key
ICICI_ACCESS_CODE=your_icici_access_code
ICICI_REDIRECT_URL=http://localhost:5000/api/payment/icici/response
ICICI_CANCEL_URL=http://localhost:3000/checkout/cancelled

# Instagram Feed
INSTAGRAM_ACCESS_TOKEN=your_instagram_access_token

# ----- Notifications: SMTP (email) -----
# Recommended: Hostinger SMTP (smtp.hostinger.com:465 SSL) or Gmail App Password.
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=orders@avakaayafoods.com
SMTP_PASS=your_smtp_password
SMTP_FROM="Avakaaya Foods <orders@avakaayafoods.com>"

# ----- Notifications: WhatsApp via Interakt -----
# Interakt dashboard → Settings → Developer Settings → copy the Secret Key.
INTERAKT_API_KEY=your_interakt_api_key
# Template names — must exactly match the approved templates created in Interakt.
INTERAKT_TEMPLATE_ORDER_CONFIRMED=interakt_autocheckout_order_placed
INTERAKT_TEMPLATE_NEW_ORDER=new_order_admin
INTERAKT_TEMPLATE_ORDER_SHIPPED=order_shipped

# ----- Admin recipient for notifications -----
ADMIN_EMAIL=admin@avakaayafoods.com
# New-order notification emails go here (falls back to ADMIN_EMAIL if unset)
ORDERS_EMAIL=orders@avakaayafoods.com
# Phone in international format WITHOUT leading +, e.g. 919115595959
ADMIN_PHONE=919115595959

# Shipping zones (base rates in INR)
INDIA_SHIPPING_FREE_ABOVE=999
INDIA_SHIPPING_RATE=80
INTERNATIONAL_SHIPPING_RATE_USD=25

MYSQL_HOST=localhost
MYSQL_USER=root
MYSQL_PASS=Avakaaya@9866
MYSQL_DB=avakaayfoods

# DB setup API secret (used instead of JWT for /api/dbsetup endpoints)
DBSETUP_SECRET=avakaaya-setup-2026

# Direct UPI payment (no gateway). Replace with your real merchant VPA.
UPI_VPA=9105299399.ibz@icici
UPI_PAYEE_NAME=Avakaaya Foods
