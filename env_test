# Server
PORT=8001
NODE_ENV=development
FRONTEND_URL=http://localhost:3000

# MongoDB
# MONGO_URI=mongodb://localhost:27017/avakaayafoods

# JWT
JWT_SECRET=your_super_secret_jwt_key_change_this_in_production
JWT_EXPIRE=7d

# Razorpay (existing online gateway)
RAZORPAY_KEY_ID=your_razorpay_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret

# ICICI Bank Payment Gateway ("Orange PG", pgpay.icicibank.com) — Standard/Redirect
# Enable the method in Admin → Payment methods once these are set + UAT verified.
ICICI_MERCHANT_ID=100000000007164
ICICI_AGGREGATOR_ID=A100000000007164
ICICI_SECRET_KEY=your_icici_shared_key
# UAT endpoints (swap to https://pgpay.icicibank.com/pg/... for production):
ICICI_SALE_URL=https://pgpayuat.icicibank.com/tsp/pg/api/v2/initiateSale
ICICI_COMMAND_URL=https://pgpayuat.icicibank.com/tsp/pg/api/command
# Public backend URL ICICI posts the payment result to (must be reachable by the bank):
ICICI_RETURN_URL=https://your-backend-host/api/payment/icici/response

# Instagram Feed
INSTAGRAM_ACCESS_TOKEN=your_instagram_access_token

# Shipping zones (base rates in INR)
INDIA_SHIPPING_FREE_ABOVE=999
INDIA_SHIPPING_RATE=80
INTERNATIONAL_SHIPPING_RATE_USD=25

# Lead tracking and abandoned checkout alerts
ABANDONED_LEAD_MINUTES=30
LEAD_ALERT_EMAIL=orders@avakaayafoods.com
